# MVP는 기본적으로 외부 검색 API를 호출하지 않는 mock 모드로 실행합니다.
SEARCH_PROVIDER=mock

# Google Cloud Vision OCR와 레거시 Web Detection에 사용합니다.
# 서버 환경변수로만 설정하며 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
GOOGLE_CLOUD_VISION_API_KEY=

# Supabase 서울 리전 프로젝트 연결용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 토스페이먼츠 테스트/라이브 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
